# Copy to .env for local deployment and replace every CHANGE_ME value.
POSTGRES_DB=ayush_epr
POSTGRES_USER=ayush
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://ayush:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@db:5432/ayush_epr
# Address of the Express API as seen by the Next.js server. Resolved at `next build` time
# (docker-compose passes http://server:4000 as a build arg; for local runs the default is http://127.0.0.1:4000).
# API_URL=http://127.0.0.1:4000
SESSION_HOURS=8
MAX_UPLOAD_MB=20
PASSWORD_SALT=CHANGE_ME_LONG_RANDOM_PASSWORD_SALT

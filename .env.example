# Copy to .env and replace every placeholder (the long names starting with CHANGE and ending in a description) with random secrets.
POSTGRES_DB=ayush_epr
POSTGRES_USER=ayush
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://ayush:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@db:5432/ayush_epr
# Address of the Express API as seen by the Next.js server. Resolved at `next build` time
# (docker-compose passes http://server:4000 as a build arg; for local runs the default is http://127.0.0.1:4000).
# API_URL=http://127.0.0.1:4000
SESSION_HOURS=8
MAX_UPLOAD_MB=20
PASSWORD_SALT=CHANGE_ME_LONG_RANDOM_PASSWORD_SALT
# Network exposure: the API is not published to the host; only the web container is, on 127.0.0.1:3000.
# Put an HTTPS reverse proxy in front of it (see SECURITY_CHECKLIST.md).

# First start only: creates the first Super Administrator (password 12+ characters). Sign in, then delete
# ADMIN_PASSWORD from .env. Further staff are added under Administration > Users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Only for the HTTPS overlay (deploy/caddy): the public hostname of this server.
# DOMAIN=epr.example.com
